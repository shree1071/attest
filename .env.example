# Public base URL used for OAuth redirects and embed snippets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enables the local demo sign-in (no LinkedIn app required).
# Turn this off before exposing the app publicly.
ALLOW_DEMO_AUTH=true

# LinkedIn OIDC credentials. Callback registered at LinkedIn must be
# http://localhost:3000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
