# Public base URL used for OAuth redirects and embed snippets.
# Production (Vercel): https://attest26.vercel.app
# Custom domain:      https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Exact callback URL registered under "Authorized redirect URLs" in the
# LinkedIn developer app. Optional: when omitted, it is derived as
# ${NEXT_PUBLIC_APP_URL}/api/auth/linkedin/callback.
# Set it when the app answers on more than one host and LinkedIn should always
# receive the canonical registered value.
LINKEDIN_REDIRECT_URI=

# Enables the local demo sign-in (no LinkedIn app required).
# Turn this off before exposing the app publicly.
ALLOW_DEMO_AUTH=true

# LinkedIn OIDC credentials.
# Register both callbacks in the LinkedIn app (Auth tab):
#   https://attest26.vercel.app/api/auth/linkedin/callback
#   http://localhost:3000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
